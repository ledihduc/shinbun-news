[Unit]
Description=shinbun.news GitHub webhook deployment service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shinbun-news
Group=shinbun-news
WorkingDirectory=/opt/shinbun-news
EnvironmentFile=/etc/shinbun-news/deploy.env
ExecStart=/usr/bin/node /opt/shinbun-news/webhook-server.mjs
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/shinbun-news

[Install]
WantedBy=multi-user.target
